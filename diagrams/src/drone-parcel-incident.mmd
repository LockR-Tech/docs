%% @title Sự cố rơi kiện Drone
%% @subtitle Nguồn: order-service/DroneParcelIncidentService · cập nhật 2026-10-30
%% @orientation portrait
%% @legend <span class="sw ok"></span>Transition đã validate ở backend
%% @legend <span class="sw gap"></span>Tích hợp vật lý/payment còn cần adapter thật
%% @note Return flight là state machine độc lập: gọi API không được coi là drone đã về Hub.
%% @note Chi bồi thường: phiếu RF-CMP ở PROCESSING; admin duyệt / từ chối phiếu ⇒ payment-service báo PAID / PAYMENT_FAILED.
%% @note RESOLVED tự động khi không còn giao lại hay chi trả dở — kể cả thoả thuận riêng không có việc qua hệ thống.
%% @note Drone không nhận lệnh quay về chỉ đổi Return flight (MANUAL_INTERVENTION_REQUIRED); sự cố vẫn INVESTIGATING. Admin xác nhận drone đã về ⇒ COMPLETED.
%% @note Báo rơi, gửi phương án, khách đồng ý ⇒ thư cho người gửi (và người nhận khi drone đã phóng).
stateDiagram-v2
    [*] --> REPORTED: report + evidence snapshot
    REPORTED --> INVESTIGATING: delivery stopped (RTL hay không)
    INVESTIGATING --> MANUAL_INTERVENTION_REQUIRED: return-flight callback FAILED
    MANUAL_INTERVENTION_REQUIRED --> INVESTIGATING: admin confirms drone back
    INVESTIGATING --> RECOVERY_IN_PROGRESS: technician starts search
    RECOVERY_IN_PROGRESS --> AWAITING_ADMIN_REVIEW: found / not found / unsafe submitted
    AWAITING_ADMIN_REVIEW --> AWAITING_CUSTOMER_RESPONSE: admin verifies and proposes
    AWAITING_CUSTOMER_RESPONSE --> RESOLUTION_IN_PROGRESS: customer accepts
    AWAITING_CUSTOMER_RESPONSE --> DISPUTED: customer requests review
    DISPUTED --> AWAITING_CUSTOMER_RESPONSE: new proposal version
    RESOLUTION_IN_PROGRESS --> RESOLVED: redelivery order completed + payout PAID (or nothing left)
    RESOLVED --> CLOSED: all linked work closed

    state "Return flight (independent physical acknowledgement)" as ReturnFlight {
        [*] --> RETURN_REQUESTED
        RETURN_REQUESTED --> COMMAND_ACCEPTED
        COMMAND_ACCEPTED --> RETURNING
        RETURNING --> COMPLETED
        RETURN_REQUESTED --> MANUAL_INTERVENTION_REQUIRED
        COMMAND_ACCEPTED --> FAILED
        RETURNING --> FAILED
        MANUAL_INTERVENTION_REQUIRED --> COMPLETED: admin confirms drone back
        FAILED --> COMPLETED: admin confirms drone back
    }
