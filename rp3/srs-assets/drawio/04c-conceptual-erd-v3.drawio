Cell><mxCell id="c132" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="944.0" y="1449.0" width="2.0" height="2.0" as="geometry"/></mxCell><mxCell id="c133" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1014.0" y="1449.0" width="2.0" height="2.0" as="geometry"/></mxCell><mxCell id="c134" value="" style="edgeStyle=none;html=1;strokeColor=#000000;startArrow=none;endFill=0;endSize=12;endArrow=ERmandOne;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c132" target="c133"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c135" value="exactly one (parent side, FK NOT NULL)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1028.0" y="1435.0" width="640.0" height="30.0" as="geometry"/></mxCell><mxCell id="c136" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="944.0" y="1479.0" width="2.0" height="2.0" as="geometry"/></mxCell><mxCell id="c137" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1014.0" y="1479.0" width="2.0" height="2.0" as="geometry"/></mxCell><mxCell id="c138" value="" style="edgeStyle=none;html=1;strokeColor=#000000;startArrow=none;endFill=0;endSize=12;endArrow=ERzeroToOne;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c136" target="c137"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c139" value="zero or one (parent side when the FK is nullable · child side of a 1 : 1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1028.0" y="1465.0" width="640.0" height="30.0" as="geometry"/></mxCell><mxCell id="c140" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="944.0" y="1509.0" width="2.0" height="2.0" as="geometry"/></mxCell><mxCell id="c141" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1014.0" y="1509.0" width="2.0" height="2.0" as="geometry"/></mxCell><mxCell id="c142" value="" style="edgeStyle=none;html=1;strokeColor=#000000;startArrow=none;endFill=0;endSize=12;endArrow=ERzeroToMany;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c140" target="c141"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c143" value="zero or many (child side of a 1 : N · both ends of an N : N)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1028.0" y="1495.0" width="640.0" height="30.0" as="geometry"/></mxCell><mxCell id="c144" value="" style="rounded=0;html=1;fillColor=#DAE8FC;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="944.0" y="1540.0" width="40.0" height="20.0" as="geometry"/></mxCell><mxCell id="c145" value="admin-configurable settings: unit prices (send base fee, rental hourly / daily rate standard · XL, drone delivery fee, overtime fee per hour, weight-step fee …) and business rules" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1028.0" y="1535.0" width="760.0" height="44.0" as="geometry"/></mxCell><mxCell id="c146" value="&lt;b&gt;N : N relationships&lt;/b&gt; (drawn directly; the logical ERD resolves each through a table)&lt;br&gt;• UserProfile N : N Promotion — a user claims many vouchers, a voucher is claimed by many users (&lt;i&gt;promotion_claims&lt;/i&gt;)&lt;br&gt;• Promotion N : N LockerOrder — an order applies many vouchers, a voucher is applied to many orders (&lt;i&gt;promotion_usages&lt;/i&gt;)&lt;br&gt;• UserProfile (locker technician) N : N LockerUnit — BLE test access (&lt;i&gt;ble_test_grants&lt;/i&gt;)&lt;br&gt;• UserProfile (drone technician) N : N DronePickup — a home pickup is offered to many technicians (&lt;i&gt;drone_pickup_offers&lt;/i&gt;)&lt;br&gt;• UserProfile — LockerBox: a user books many boxes, a box is booked by many users at different times; kept as the &lt;b&gt;LockerOrder&lt;/b&gt; entity because the order has its own data and relationships (payment, status history, rating, drone mission …)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#000000;strokeColor=#999999;fillColor=#FAFAFA;spacing=10;" vertex="1" parent="1"><mxGeometry x="20.0" y="1435.0" width="884.0" height="150.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>