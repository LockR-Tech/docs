!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
hide circle
hide empty methods
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #C0504D
  HeaderBackgroundColor #FFE8E1
}
skinparam package {
  BorderColor #999999
  FontColor #555555
}
